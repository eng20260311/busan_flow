# Enter real keys in .env only.
SAFETY_API_KEY=
TOUR_API_KEY=
# Optional separate key for DataLabService; falls back to TOUR_API_KEY.
DATALAB_API_KEY=
# Optional: TMAP transit/routes enabled app key, read on server only.
TMAP_APP_KEY=
# Optional: Kakao Mobility directions REST API key (server only).
KAKAO_REST_API_KEY=
# Optional: set both to enable LLM intent classification. Otherwise rules are used.
OPENAI_API_KEY=
OPENAI_MODEL=
